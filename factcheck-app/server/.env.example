# Copy to .env and fill in real values. .env is gitignored.

# Google Gemini API key — free tier, no billing required
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Tavily web search API key — free tier (1,000 searches/month)
# Get one at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Allow your client origin (comma-separated for multiple).
# Local dev default: http://localhost:5173
# Production: your Vercel client URL, e.g. https://factcheck.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# Optional — Render injects PORT automatically. Defaults to 4000 locally.
# PORT=4000

# Optional — pin a Gemini model. Defaults to "gemini-2.0-flash".
# GEMINI_MODEL=gemini-2.0-flash
